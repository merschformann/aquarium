<Project>
  <!-- Settings shared by all Aquarium projects (stops MSBuild from picking up settings of a surrounding repository). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaVersion>12.1.6</AvaloniaVersion>
    <Authors>Marius Merschformann</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <!-- Default version for local builds, releases set it from the tag (dotnet pack -p:Version=x.y.z) -->
    <Version>0.1.0</Version>
    <PackageProjectUrl>https://github.com/merschformann/aquarium</PackageProjectUrl>
    <RepositoryUrl>https://github.com/merschformann/aquarium</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- XML docs (IntelliSense for package users) and a symbol package (debugging into the library) -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition=" '$(GITHUB_ACTIONS)' == 'true' ">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
